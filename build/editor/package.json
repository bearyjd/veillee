{
  "name": "veillee-editor-bundle",
  "private": true,
  "version": "0.1.0",
  "description": "Build-time only. Produces src/veillee/web/static/vendor/editor.{js,css}, which are committed.",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=iife --global-name=VeilleeEditor --minify --loader:.ttf=empty --loader:.woff=empty --loader:.woff2=empty --outfile=../../src/veillee/web/static/vendor/editor.js"
  },
  "dependencies": {
    "@milkdown/crepe": "7.6.2"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
